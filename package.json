    "canvas-confetti": "^1.9.4",
    "copy-to-clipboard": "^4.0.2",
    "esm-seedrandom": "^3.0.5-esm.2",
    "fuse.js": "^7.5.0",
    "localforage": "^1.10.0",
    "lucide-react": "^1.66.0",
    "pocketbase": "^0.28.2",
